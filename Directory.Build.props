<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <Version>0.1.0</Version>
    <Product>DeskKit</Product>
    <Authors>DeskKit contributors</Authors>
    <!-- The language the resource files that carry no culture of their own are
         written in; see the JSON under src/*/Resources. -->
    <NeutralLanguage>en</NeutralLanguage>

    <!-- Compile every XAML binding so binding errors fail the build instead of
         silently producing a blank widget at runtime. Each view must declare
         x:DataType / x:CompileBindings. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
