<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeskKit.App.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DeskKit.Widgets/Shared/WidgetTheme.axaml" />
                <ResourceInclude Source="avares://DeskKit.App/Resources/AppTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://DeskKit.Widgets/Shared/WidgetStyles.axaml" />
        <StyleInclude Source="avares://DeskKit.App/Resources/AppStyles.axaml" />
    </Application.Styles>
</Application>
