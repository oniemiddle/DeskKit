<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The product is a Windows application: it has a manifest, it pins windows into
         the desktop layer and it registers itself to start with the shell. Targeting
         Windows is what selects the platform implementations in DeskKit.Platform at
         compile time instead of testing the OS at run time. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- The placement rules are exercised against stand-in rectangles rather than real
         windows, so the test needs the internals the app keeps to itself. -->
    <InternalsVisibleTo Include="DeskKit.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskKit.Core\DeskKit.Core.csproj" />
    <ProjectReference Include="..\DeskKit.Persistence\DeskKit.Persistence.csproj" />
    <ProjectReference Include="..\DeskKit.Platform\DeskKit.Platform.csproj" />
    <ProjectReference Include="..\DeskKit.Runtime\DeskKit.Runtime.csproj" />
    <ProjectReference Include="..\DeskKit.Widgets\DeskKit.Widgets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Irihi.Lingua" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Lingua source generator reads the resource files from here and turns
         each key into a strongly-typed observable property. -->
    <AdditionalFiles Include="Resources\**\*.json" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
  </ItemGroup>

</Project>
