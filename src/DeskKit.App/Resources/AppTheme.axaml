<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Design tokens for the application's own chrome — currently the settings
         window. Widget content colours live in DeskKit.Widgets' WidgetTheme.axaml
         and follow the same per-variant pattern; the values here use the Windows
         11 settings vocabulary (8px cards, 6px navigation pills, quiet captions). -->

    <x:Double x:Key="FontSizeCaption">11</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>

    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="NavCornerRadius">6</CornerRadius>

    <!-- The radius every Fluent control (button, text box, combo box, list row,
         slider thumb) rounds itself to. Fluent reads it through a dynamic
         resource, so one value restyles them all at once. -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>

    <!-- Brand accent, used outright where a control exposes it as a brush. It is
         theme-independent: #2563EB reads the same on either backdrop. -->
    <SolidColorBrush x:Key="AccentFill">#FF2563EB</SolidColorBrush>

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
            <!-- Fluent's own accent seed. The theme derives its highlight,
                 selection and focus brushes from these colours, so re-seeding it
                 recolours every accent-driven control to the brand blue. -->
            <Color x:Key="SystemAccentColor">#FF2563EB</Color>
            <Color x:Key="SystemAccentColorDark1">#FF1D4ED8</Color>
            <Color x:Key="SystemAccentColorDark2">#FF1E40AF</Color>
            <Color x:Key="SystemAccentColorDark3">#FF1E3A8A</Color>
            <Color x:Key="SystemAccentColorLight1">#FF3B82F6</Color>
            <Color x:Key="SystemAccentColorLight2">#FF60A5FA</Color>
            <Color x:Key="SystemAccentColorLight3">#FF93C5FD</Color>

            <SolidColorBrush x:Key="SettingsCardBackground">#0BFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="SettingsCardBorderBrush">#14FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="SettingsHintForeground">#8CFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="NavHoverBackground">#14FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="NavSelectedBackground">#332563EB</SolidColorBrush>
            <SolidColorBrush x:Key="NavSelectedForeground">#FF8FAEFF</SolidColorBrush>

            <!-- Resting, hovered and pressed fill for every quiet control, plus
                 the hairline that gives them an edge on a busy backdrop. -->
            <SolidColorBrush x:Key="ControlFill">#0FFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ControlFillHover">#1AFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ControlFillPressed">#0AFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ControlStroke">#17FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ControlStrokeHover">#26FFFFFF</SolidColorBrush>

            <!-- List rows: a neutral hover, the accent-tinted selection the
                 navigation rail already uses. -->
            <SolidColorBrush x:Key="ListChoiceHover">#14FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ListChoiceSelected">#332563EB</SolidColorBrush>

            <!-- Fluent Button -->
            <SolidColorBrush x:Key="ButtonBackground">#0FFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver">#1AFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonBackgroundPressed">#0AFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonBorderBrush">#17FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver">#26FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonBorderBrushPressed">#26FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonForeground">#F2FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonForegroundPointerOver">#FFFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonForegroundPressed">#B3FFFFFF</SolidColorBrush>

            <!-- Fluent TextBox -->
            <SolidColorBrush x:Key="TextControlBackground">#0FFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver">#14FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="TextControlBackgroundFocused">#0FFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="TextControlBorderBrush">#17FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver">#26FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused">#FF3B82F6</SolidColorBrush>
            <SolidColorBrush x:Key="TextControlForeground">#F2FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor">#662563EB</SolidColorBrush>

            <!-- Fluent ComboBox -->
            <SolidColorBrush x:Key="ComboBoxBackground">#0FFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver">#1AFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed">#0AFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ComboBoxBorderBrush">#17FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver">#26FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed">#26FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ComboBoxForeground">#F2FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ComboBoxDropDownBackground">#F22B2B2B</SolidColorBrush>
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush">#1FFFFFFF</SolidColorBrush>

            <!-- Fluent Slider: a quiet groove, brand-blue value and thumb. -->
            <SolidColorBrush x:Key="SliderTrackFill">#33FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="SliderTrackValueFill">#FF2563EB</SolidColorBrush>
            <SolidColorBrush x:Key="SliderThumbBackground">#FF2563EB</SolidColorBrush>

            <!-- Fluent ToggleSwitch -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn">#FF2563EB</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver">#FF3B82F6</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchFillOff">#0FFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn">#FFFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff">#F2FFFFFF</SolidColorBrush>

            <!-- Fluent CheckBox -->
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked">#FF2563EB</SolidColorBrush>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver">#FF3B82F6</SolidColorBrush>
            <SolidColorBrush x:Key="CheckBoxCheckBorderBrush">#17FFFFFF</SolidColorBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#FF2563EB</Color>
            <Color x:Key="SystemAccentColorDark1">#FF1D4ED8</Color>
            <Color x:Key="SystemAccentColorDark2">#FF1E40AF</Color>
            <Color x:Key="SystemAccentColorDark3">#FF1E3A8A</Color>
            <Color x:Key="SystemAccentColorLight1">#FF3B82F6</Color>
            <Color x:Key="SystemAccentColorLight2">#FF60A5FA</Color>
            <Color x:Key="SystemAccentColorLight3">#FF93C5FD</Color>

            <SolidColorBrush x:Key="SettingsCardBackground">#06000000</SolidColorBrush>
            <SolidColorBrush x:Key="SettingsCardBorderBrush">#0F000000</SolidColorBrush>
            <SolidColorBrush x:Key="SettingsHintForeground">#8C000000</SolidColorBrush>
            <SolidColorBrush x:Key="NavHoverBackground">#0A000000</SolidColorBrush>
            <SolidColorBrush x:Key="NavSelectedBackground">#222563EB</SolidColorBrush>
            <SolidColorBrush x:Key="NavSelectedForeground">#FF2563EB</SolidColorBrush>

            <SolidColorBrush x:Key="ControlFill">#0A000000</SolidColorBrush>
            <SolidColorBrush x:Key="ControlFillHover">#14000000</SolidColorBrush>
            <SolidColorBrush x:Key="ControlFillPressed">#06000000</SolidColorBrush>
            <SolidColorBrush x:Key="ControlStroke">#17000000</SolidColorBrush>
            <SolidColorBrush x:Key="ControlStrokeHover">#26000000</SolidColorBrush>

            <SolidColorBrush x:Key="ListChoiceHover">#0A000000</SolidColorBrush>
            <SolidColorBrush x:Key="ListChoiceSelected">#222563EB</SolidColorBrush>

            <SolidColorBrush x:Key="ButtonBackground">#0A000000</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver">#14000000</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonBackgroundPressed">#06000000</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonBorderBrush">#17000000</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver">#26000000</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonBorderBrushPressed">#26000000</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonForeground">#E61F2937</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonForegroundPointerOver">#FF1F2937</SolidColorBrush>
            <SolidColorBrush x:Key="ButtonForegroundPressed">#991F2937</SolidColorBrush>

            <SolidColorBrush x:Key="TextControlBackground">#0A000000</SolidColorBrush>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver">#12000000</SolidColorBrush>
            <SolidColorBrush x:Key="TextControlBackgroundFocused">#0A000000</SolidColorBrush>
            <SolidColorBrush x:Key="TextControlBorderBrush">#17000000</SolidColorBrush>
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver">#26000000</SolidColorBrush>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused">#FF2563EB</SolidColorBrush>
            <SolidColorBrush x:Key="TextControlForeground">#E61F2937</SolidColorBrush>
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor">#552563EB</SolidColorBrush>

            <SolidColorBrush x:Key="ComboBoxBackground">#0A000000</SolidColorBrush>
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver">#14000000</SolidColorBrush>
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed">#06000000</SolidColorBrush>
            <SolidColorBrush x:Key="ComboBoxBorderBrush">#17000000</SolidColorBrush>
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver">#26000000</SolidColorBrush>
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed">#26000000</SolidColorBrush>
            <SolidColorBrush x:Key="ComboBoxForeground">#E61F2937</SolidColorBrush>
            <SolidColorBrush x:Key="ComboBoxDropDownBackground">#FFF7F7F7</SolidColorBrush>
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush">#14000000</SolidColorBrush>

            <SolidColorBrush x:Key="SliderTrackFill">#33000000</SolidColorBrush>
            <SolidColorBrush x:Key="SliderTrackValueFill">#FF2563EB</SolidColorBrush>
            <SolidColorBrush x:Key="SliderThumbBackground">#FF2563EB</SolidColorBrush>

            <SolidColorBrush x:Key="ToggleSwitchFillOn">#FF2563EB</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver">#FF1D4ED8</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchFillOff">#0A000000</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn">#FFFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff">#FF1F2937</SolidColorBrush>

            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked">#FF2563EB</SolidColorBrush>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver">#FF1D4ED8</SolidColorBrush>
            <SolidColorBrush x:Key="CheckBoxCheckBorderBrush">#17000000</SolidColorBrush>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
