<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The interop declarations use character buffers for the structures the shell
         fills in, and LibraryImport's generated stubs are compiled unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskKit.Core\DeskKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed only so the Shell icon loader can hand back an Avalonia bitmap. -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
