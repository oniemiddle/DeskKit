<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:clock="using:DeskKit.Widgets.Clock"
             xmlns:loc="using:DeskKit.Widgets.Localization"
             x:Class="DeskKit.Widgets.Clock.ClockSettingsView"
             x:DataType="clock:ClockViewModel">

    <StackPanel Spacing="14">
        <TextBlock FontWeight="SemiBold" Text="{Translate {x:Static loc:WidgetLanguage+Keys.Clock_Title}}" />

        <CheckBox Content="{Translate {x:Static loc:WidgetLanguage+Keys.Clock_Use24Hour}}"
                  IsChecked="{Binding Use24Hour}" />
        <CheckBox Content="{Translate {x:Static loc:WidgetLanguage+Keys.Clock_ShowSeconds}}"
                  IsChecked="{Binding ShowSeconds}" />
        <CheckBox Content="{Translate {x:Static loc:WidgetLanguage+Keys.Clock_ShowDate}}"
                  IsChecked="{Binding ShowDate}" />
        <CheckBox Content="{Translate {x:Static loc:WidgetLanguage+Keys.Clock_ShowWeekday}}"
                  IsChecked="{Binding ShowWeekday}" />

        <StackPanel Spacing="4">
            <TextBlock Text="{Translate {x:Static loc:WidgetLanguage+Keys.Clock_TimeFontSize}}" />
            <Slider Minimum="18"
                    Maximum="88"
                    TickFrequency="2"
                    IsSnapToTickEnabled="True"
                    Value="{Binding TimeFontSize}" />
        </StackPanel>
    </StackPanel>
</UserControl>
