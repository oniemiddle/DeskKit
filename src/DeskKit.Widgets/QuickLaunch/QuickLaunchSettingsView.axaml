<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ql="using:DeskKit.Widgets.QuickLaunch"
             xmlns:loc="using:DeskKit.Widgets.Localization"
             x:Class="DeskKit.Widgets.QuickLaunch.QuickLaunchSettingsView"
             x:DataType="ql:QuickLaunchViewModel">

    <StackPanel Spacing="14">
        <TextBlock FontWeight="SemiBold" Text="{Translate {x:Static loc:WidgetLanguage+Keys.Launch_Title}}" />

        <TextBlock Opacity="0.7"
                   TextWrapping="Wrap"
                   Text="{Translate {x:Static loc:WidgetLanguage+Keys.Launch_Hint}}" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Name="BrowseButton"
                    Content="{Translate {x:Static loc:WidgetLanguage+Keys.Launch_AddFile}}"
                    Click="OnBrowseClick" />
            <TextBox Name="UrlBox"
                     Width="200"
                     PlaceholderText="{Translate {x:Static loc:WidgetLanguage+Keys.Launch_UrlPlaceholder}}" />
            <Button Content="{Translate {x:Static loc:WidgetLanguage+Keys.Launch_AddUrl}}"
                    Click="OnAddUrlClick" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="{Translate {x:Static loc:WidgetLanguage+Keys.Launch_IconSize}}" />            <Slider Minimum="20"
                    Maximum="72"
                    TickFrequency="2"
                    IsSnapToTickEnabled="True"
                    Value="{Binding IconSize}" />
        </StackPanel>

        <TextBlock Text="{Translate {x:Static loc:WidgetLanguage+Keys.Launch_Items}}" FontWeight="SemiBold" />

        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ql:QuickLaunchItemViewModel">
                    <Grid Margin="0,2" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="0">
                            <TextBlock Text="{Binding DisplayName}" />
                            <TextBlock Opacity="0.6"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Target}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="{Translate {x:Static loc:WidgetLanguage+Keys.Launch_Remove}}"
                                Command="{Binding RemoveFromWidgetCommand}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
