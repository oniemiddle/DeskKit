<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Widget content colours come from WidgetTheme.axaml, which has one set per
         theme variant. They used to be fixed light-on-dark, because a widget always
         painted its own dark card; now the default background is only the surface
         material, and the material follows the same light/dark preference the app
         does, so the content has to follow it too. -->

    <Style Selector="TextBlock.widget-primary">
        <Setter Property="Foreground" Value="{DynamicResource WidgetPrimaryForeground}" />
    </Style>

    <Style Selector="TextBlock.widget-secondary">
        <Setter Property="Foreground" Value="{DynamicResource WidgetSecondaryForeground}" />
    </Style>

    <Style Selector="TextBox.plain">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource WidgetPrimaryForeground}" />
        <Setter Property="CaretBrush" Value="{DynamicResource WidgetPrimaryForeground}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource WidgetSelectionSurface}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource WidgetSelectionForeground}" />
    </Style>

    <Style Selector="TextBox.plain /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.quick-launch">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.quick-launch:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource WidgetHoverSurface}" />
    </Style>
</Styles>
