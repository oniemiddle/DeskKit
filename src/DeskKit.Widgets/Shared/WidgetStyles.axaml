<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Widgets keep a dark translucent surface in both light and dark themes:
         a desktop widget sits on top of an arbitrary wallpaper, so a fixed,
         high-contrast surface reads better than one that follows the app theme
         (which drives the settings window). -->

    <Style Selector="TextBlock.widget-primary">
        <Setter Property="Foreground" Value="#F2FFFFFF" />
    </Style>

    <Style Selector="TextBlock.widget-secondary">
        <Setter Property="Foreground" Value="#A6FFFFFF" />
    </Style>

    <Style Selector="TextBox.plain">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Foreground" Value="#F2FFFFFF" />
        <Setter Property="CaretBrush" Value="#F2FFFFFF" />
        <Setter Property="SelectionBrush" Value="#552563EB" />
        <Setter Property="SelectionForegroundBrush" Value="#FFFFFFFF" />
    </Style>

    <Style Selector="TextBox.plain /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.quick-launch">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.quick-launch:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
</Styles>
