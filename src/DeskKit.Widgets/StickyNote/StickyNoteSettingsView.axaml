<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:note="using:DeskKit.Widgets.StickyNote"
             x:Class="DeskKit.Widgets.StickyNote.StickyNoteSettingsView"
             x:DataType="note:StickyNoteViewModel">

    <StackPanel Spacing="14">
        <TextBlock FontWeight="SemiBold" Text="便签" />

        <StackPanel Spacing="4">
            <TextBlock Text="纸张颜色" />
            <ListBox Height="150"
                     ItemsSource="{Binding PaperNames}"
                     SelectedIndex="{Binding PaperIndex}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="字号" />
            <Slider Minimum="10"
                    Maximum="32"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    Value="{Binding NoteFontSize}" />
        </StackPanel>
    </StackPanel>
</UserControl>
