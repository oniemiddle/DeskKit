<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:note="using:DeskKit.Widgets.StickyNote"
             xmlns:loc="using:DeskKit.Widgets.Localization"
             x:Class="DeskKit.Widgets.StickyNote.StickyNoteView"
             x:DataType="note:StickyNoteViewModel">

    <!-- The paper must not round itself. Its shape comes from the card, which is
         clipped to a rounded outline when there is no material, and from the
         window's own platform rounding when a material fills it. A radius here
         would be a second, differently-sized outline: over a material the mica
         shows through the sliver between the two and reads as a dark fringe along
         the corners. It only looked right before because both radii happened to
         be 14. -->
    <Border Background="{Binding PaperBrush}">
        <Grid Margin="16,18,16,14" RowDefinitions="Auto,*">
            <TextBox Grid.Row="0"
                     Classes="plain"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="#E61F2937"
                     CaretBrush="#E61F2937"
                     SelectionBrush="#552563EB"
                     Text="{Binding Title}"
                     PlaceholderText="{Translate {x:Static loc:WidgetLanguage+Keys.Note_TitlePlaceholder}}" />

            <TextBox Grid.Row="1"
                     Margin="0,6,0,0"
                     Classes="plain"
                     AcceptsReturn="True"
                     FontSize="{Binding NoteFontSize}"
                     Foreground="#E61F2937"
                     CaretBrush="#E61F2937"
                     SelectionBrush="#552563EB"
                     Text="{Binding Body}"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     PlaceholderText="{Translate {x:Static loc:WidgetLanguage+Keys.Note_BodyPlaceholder}}" />
        </Grid>
    </Border>
</UserControl>
